<?php
/* Хат — смена пароля в почте (плагин Roundcube «password», драйвер mailcow).
   Шаблон без секретов: __APIHOST__ и __APIKEY__ подставляются на сервере.
   Названия настроек сверить с plugins/password/config.inc.php.dist установленной версии
   и с инструкцией mailcow (Roundcube → Password change). */

$config['password_driver'] = 'mailcow';
$config['password_mailcow_api_host'] = '__APIHOST__';
$config['password_mailcow_api_token'] = '__APIKEY__';

// Требования к новому паролю
$config['password_confirm_current'] = true;   // спрашивать старый пароль
$config['password_minimum_length'] = 8;
$config['password_require_nonalpha'] = true;  // хотя бы одна цифра или знак
